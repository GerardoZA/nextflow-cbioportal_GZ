/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CRCHUM-CITADEL/nextflow-sante-precision Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Pipeline mode. Options: "genomic", "clinical", "both"
    //   genomic   — process oncoanalyser output into cBioPortal genomic files
    //   clinical  — transform clinical CSVs into cBioPortal patient/sample attribute files
    //   both      — run genomic then clinical in one invocation; genomic produces a
    //               linking file that is automatically passed to the clinical workflow
    //               (no need to set sample_registrations separately)
    mode                = "both"

    // Sequencing data type for the genomic workflow. Options: "both", "dna-only"
    //   both      — (default) expects RNA-derived oncoanalyser output (Isofox expression/
    //               fusion, SAGE RNA-append) for every genomic subject; RNA is integrated
    //               into mutations, expression, and fusion cBioPortal files
    //   dna-only  — skips all RNA-derived processing (Isofox expression, Isofox fusion,
    //               SAGE RNA-append integration into mutations) and omits the expression
    //               profile/meta file entirely, even if RNA files are present on disk
    type                = "both"

    // Study metadata (written into meta_study.txt)
    study_id            = "" // short identifier, e.g. "MY_COHORT_2025"
    project_description = "" // human-readable description of the study
    cancer_type         = "" // cancer type abbreviation for cBioPortal (e.g. "mixed", "lung", "brca")
    generate_cancer_type = false // when true, generate cancer_type.txt and meta_cancer_type.txt

    // ── GENOMIC INPUT ────────────────────────────────────────────────────────────
    // CSV with one row per subject. Required columns:
    //   group        — study/cohort identifier (no spaces)
    //   subject_id   — patient identifier (used to resolve oncoanalyser filenames)
    //   sample_id    — sample base name
    //   folder       — absolute path to the per-subject oncoanalyser output directory
    //
    // Generate automatically with:
    //   python3 bin/generate_samplesheet.py /path/to/oncoanalyser_output -o samplesheet.csv
    genomic_samplesheet        = ""

    // ── CLINICAL INPUT ───────────────────────────────────────────────────────────
    // CSV listing one ARGO/ICGC-ARGO clinical file per row. Required columns:
    //   group_id         — study/cohort identifier
    //   filetype         — one of: donors, primary_diagnoses, treatments, surgeries,
    //                              systemic_therapies, specimens, radiations, follow_ups,
    //                              sample_registrations, biomarkers
    //   filepath         — path to the clinical CSV file
    //   extraction_date  — date data was exported (YYYY-MM-DD)
    //   info             — optional free-text note (may be empty)
    //
    // Example row:
    //   COHORT1,donors,/data/clinical/donors.csv,2025-05-20,
    //
    // See assets/test_data/samplesheet/test_clinical.csv for a full example.
    // See assets/test_data/clinical/ for example CSVs for each filetype.
    //
    // In "both" mode: the genomic workflow generates a linking file that is
    // automatically passed to the clinical workflow to filter output to genomic
    // subjects. If clinical_samplesheet is omitted in "both" mode, a minimal
    // template data_clinical_sample.txt is generated from the linking file.
    clinical_samplesheet       = ""

    // Path to sample_registrations.csv — only needed in "clinical" mode when
    // no clinical_samplesheet is provided (template fallback). In "both" mode
    // the linking file from the genomic workflow is used instead.
    sample_registrations       = ""

    // MOHCCN ontology mapping tables (adds code columns to clinical sample output)
    mohccn_primary_site_map           = "${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_primary_site.csv"
    mohccn_specimen_tissue_source_map = "${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_specimen_tissue_source.csv"
    mohccn_treatment_intent_map       = "${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_treatment_intent.csv"

    // ── GENOMIC PARAMETERS ───────────────────────────────────────────────────────
    // File paths are resolved relative to subject_id from the genomic samplesheet:
    //   <folder>/pave/<subject_id>-T.pave.somatic.vcf.gz
    //   <folder>/pave/<subject_id>-T.pave.germline.vcf.gz
    //   <folder>/sage_append/somatic/<subject_id>-T.sage.append.vcf.gz
    //   <folder>/esvee/<subject_id>-T.esvee.somatic.vcf.gz
    //   <folder>/purple/<subject_id>-T.purple.cnv.gene.tsv
    //   <folder>/isofox/<subject_id>-T-RNA.isf.gene_data.csv
    //   <folder>/isofox/<subject_id>-T-RNA.isf.pass_fusions.csv
    //   <folder>/sigs/<subject_id>-T.sig.snv_counts.csv

    // Helper annotation files:
    ensembl_annotations        = "/project/60005/shared/resources/genomes/grch38/annotations/ensembl/biomart_grch38_ensembl_113_with_entrez_id.tsv"  // BioMart TSV — used for PURPLE CNV gene→Entrez mapping and ESVEE breakpoint gene annotation
    ensembl_annotations_expr   = "/project/60005/shared/resources/genomes/grch38/annotations/ensembl/biomart_grch38_ensembl_110_with_entrez_id.tsv"  // BioMart TSV — used for Isofox expression Ensembl→Entrez ID mapping

    vep_data                   = "/project/60005/shared/software/ensembl-vep-release-113.0/cache"
    vep_params                 = "--cache-version 113 --ncbi-build=GRCh38"
    pcgr_data                  = "/project/60005/shared/resources/genomes/grch38/pcgr_ref_data" // if empty, will download from PCGR servers (may fail on compute nodes)

    // Genome reference FASTA (GRCh38) — required for vcf2maf
    genome_reference           = "/project/60005/shared/resources/genomes/grch38/dragen_cqgc/Homo_sapiens_assembly38.fasta"

    // COSMIC/ChimerKB fusion data for ML SV processing
    cosmic_data                = "/project/60005/shared/resources/cosmic_fusions/Cosmic_Fusion_v103_GRCh38.tsv"
    chimer_data              = "${projectDir}/assets/test_data/annotations/ChimerKB4.xlsx"

    // COSMIC v3.6 mutational signature references
    cosmic_reference           = "${projectDir}/assets/COSMIC_Human_v3.6.zip"
    sbs_metadata               = "${projectDir}/assets/cosmic_sbs_metadata.tsv"
    dbs_metadata               = "${projectDir}/assets/cosmic_dbs_metadata.tsv"
    id_metadata                = "${projectDir}/assets/cosmic_id_metadata.tsv"

    // containers
    container_vcf2maf            = "community.wave.seqera.io/library/vcf2maf_ensembl-vep:1b486a30e76e2908" // link to vcf2maf container created by Wave-cli
    container_python             = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/ghcr.io-crchum-citadel-sdp-python-3.12.sif"
    container_r                  = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/ghcr.io-crchum-citadel-sdp-r-4.5.1.sif"
    container_pcgr               = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/ghcr.io-sigven-pcgr-2.2.5.sif"
    container_sigprofiler        = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/sigprofiler_v1.1.3.sif"

    // Boilerplate options
    outdir                       = 'output_mohq_cm_' +  new java.util.Date().format('yyyy-MM-dd')
    input_dir                    = "${projectDir}"
    // publish_dir_mode          = 'copy' // this pollutes the output directory with output from processes so I removed it for now
    email                        = 'justin.bellavance.chum@ssss.gouv.qc.ca'
    email_on_fail                = 'justin.bellavance.chum@ssss.gouv.qc.ca'
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    version                      = false
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')// Config options
    config_profile_name          = null
    config_profile_description   = null

    custom_config_version        = 'master'
    custom_config_base           = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact       = null
    config_profile_url           = null
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.pullTimeout   = "5 min"
        apptainer.cacheDir      = "/project/60005/shared/scratch/"
    }
    gpu {
        apptainer.runOptions    = '--nv'
    }
    slurm {
        executor {
            name = 'slurm'
            queueSize = 1000 // Maximum number of jobs that can be submitted at once
            submitRateLimit = '10 sec'  // Limit job submission rate
            pollInterval = '30 sec'  // How often to check job status
            queueStatInterval = '5 min'  // How often to fetch queue status
            exitReadTimeout = '90 sec'  // Timeout for reading exit status
        }

        process {
            // Default SLURM directives for all processes
            executor = 'slurm'
            clusterOptions = '--account=def-chasse'  // Replace with your account

            // Default resource requirements
            cpus = 1
            memory = '1 GB'
            time = '5 min'

            // Error handling
            errorStrategy = 'retry'
            maxRetries = 1

        }
    }
    // Use with -profile test,apptainer,local when containers are built locally
    // (bypasses ORAS pull when GHCR auth is not available)
    local {
        params {
            container_r       = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-r-4.5.1.sif"
            container_python  = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-python-3.12.sif"
            container_vcf2maf = "${projectDir}/containers/ghcr.io-crchum-citadel-vcf2maf_ensembl-vep-v1.6.22_2.sif"
            container_pcgr          = "${projectDir}/containers/ghcr.io-sigven-pcgr-2.1.2.singularity.sif"
            container_sigprofiler   = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-sigprofiler-1.1.3.sif"
        }
    }
    test {
        process {
            maxForks = 4
            resourceLimits = [
                cpus: 1,
                memory: '30.GB',
                time: '2.h'
            ]
        }
        params {
                mode                        = "genomic"
                input_dir                   = "${projectDir}"
                genomic_samplesheet         = "${projectDir}/assets/test_data/samplesheet/test_genomic_2.csv"
                ensembl_annotations         = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_chr21.tsv"
                ensembl_annotations_expr    = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_chr21.tsv"
                genome_reference            = "${projectDir}/assets/test_data/reference/Homo_sapiens_assembly38_chr21.fasta"
                vep_data                    = "" // if empty, will attempt to download the chr21 test data set
                vep_params                  = "--cache-version 112 --ncbi-build=GRCh38 --test"
                pcgr_data                   = "" // if empty, will attempt to download PCGR reference data
                cosmic_data                 = ""
                chimer_data                 = "${projectDir}/assets/test_data/annotations/ChimerKB4.xlsx"

                container_pcgr              = "oras://ghcr.io/sigven/pcgr:2.1.2.singularity"
                container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
                container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
                container_vcf2maf           = "oras://ghcr.io/crchum-citadel/vcf2maf_ensembl-vep:v1.6.22_2"
                container_sigprofiler       = "oras://ghcr.io/crchum-citadel/sdp-sigprofiler:1.1.3"

                // clinical params:
                clinical_samplesheet        = "${projectDir}/assets/test_data/samplesheet/test_clinical.csv"
                sample_registrations        = ""
        }
    }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load CRCHUM-CITADEL/nextflow-sante-precision custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load CRCHUM-CITADEL/nextflow-sante-precision custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/test.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
singularity.registry  = 'ghcr.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

process {
  withName: 'BCFTOOLS_INDEX' {
    ext.args = '--tbi'
  }
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'CRCHUM-CITADEL/nextflow-sante-precision'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Justin Bellavance',
            affiliation: 'CITADEL',
            email: 'justin.bellavance.chum@ssss.gouv.qc.ca',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/CRCHUM-CITADEL/nextflow-cbioportal'
    description     = """Nextflow pipeline: nf-core/oncoanalyser outputs -> cBioPortal-ready files"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.2'
    version         = '3.2.1'
    doi             = ''
}


plugins {
    id 'nf-schema@2.5.1'
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
